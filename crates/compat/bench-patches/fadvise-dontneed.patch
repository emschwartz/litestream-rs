diff --git a/crates/sqlite/src/pages.rs b/crates/sqlite/src/pages.rs
index 5059f9406..93d72447d 100644
--- a/crates/sqlite/src/pages.rs
+++ b/crates/sqlite/src/pages.rs
@@ -210,13 +210,32 @@ impl PageSource for Sqlite {
             return Err(SourceError::Io(io::ErrorKind::InvalidInput));
         }
         let offset = page_offset(pgno, size).ok_or(SourceError::Io(io::ErrorKind::InvalidInput))?;
-        inner.file().read_at(buf, offset).map_err(|rc| {
+        let read = inner.file().read_at(buf, offset).map_err(|rc| {
             if rc == ffi::SQLITE_IOERR_SHORT_READ {
                 SourceError::Short { pgno }
             } else {
                 rc_error(rc)
             }
-        })
+        });
+        // BENCH PROTOTYPE (fadvise-dontneed.patch): the pages read are dropped from the cache in
+        // runs of 1 MiB, so a copy that reads the whole file leaves almost nothing of it behind.
+        let len = u64::from(size);
+        let (mut early, mut full) = (None, None);
+        let (start, run) = inner.advise.unwrap_or((offset, 0));
+        if offset == start.saturating_add(run) {
+            inner.advise = Some((start, run.saturating_add(len)));
+        } else {
+            early = Some((start, run));
+            inner.advise = Some((offset, len));
+        }
+        if let Some((from, n)) = inner.advise.filter(|(_, n)| *n >= 1 << 20) {
+            full = Some((from, n));
+            inner.advise = None;
+        }
+        for (from, n) in [early, full].into_iter().flatten() {
+            crate::identity::advise_dontneed(inner.reader.handle(), from, n);
+        }
+        read
     }
 }
 
