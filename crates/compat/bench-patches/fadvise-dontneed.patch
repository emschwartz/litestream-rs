diff --git a/crates/sqlite/src/identity.rs b/crates/sqlite/src/identity.rs
index 9841cc9dc..67e3a8f40 100644
--- a/crates/sqlite/src/identity.rs
+++ b/crates/sqlite/src/identity.rs
@@ -66,6 +66,43 @@ mod unix {
             .map(|meta| DatabaseFile::of_metadata(&meta))
     }
 
+    /// BENCH PROTOTYPE (crates/compat/bench-patches/fadvise-dontneed.patch, never in the engine):
+    /// tells the kernel it may drop the cached pages of `offset..offset + len` of the database,
+    /// through the descriptor SQLite holds (never closed, never duplicated). Linux only; elsewhere
+    /// a no-op.
+    pub(super) fn advise_dontneed(conn: Handle<'_>, offset: u64, len: u64) {
+        let Some(name) = conn.vfs_name() else { return };
+        if !is_unix_family(&name) {
+            return;
+        }
+        let Ok(file) = file_pointer(conn, MAIN) else {
+            return;
+        };
+        let Some(fd) = descriptor(file) else { return };
+        fadvise_dontneed(fd, offset, len);
+    }
+
+    #[cfg(target_os = "linux")]
+    #[expect(
+        unsafe_code,
+        reason = "a borrowed descriptor, for one posix_fadvise call"
+    )]
+    fn fadvise_dontneed(fd: RawFd, offset: u64, len: u64) {
+        // SAFETY: `fd` is open for the reader's whole life, and this borrow ends with the call.
+        let borrowed = unsafe { std::os::fd::BorrowedFd::borrow_raw(fd) };
+        drop(rustix::fs::fadvise(
+            borrowed,
+            offset,
+            std::num::NonZeroU64::new(len),
+            rustix::fs::Advice::DontNeed,
+        ));
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    fn fadvise_dontneed(fd: RawFd, offset: u64, len: u64) {
+        let _ = (fd, offset, len);
+    }
+
     pub(super) fn opened(conn: Handle<'_>) -> Option<DatabaseFile> {
         if !is_unix_family(&conn.vfs_name()?) {
             return None;
