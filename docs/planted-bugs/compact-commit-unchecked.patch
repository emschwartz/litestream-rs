+    /// Wraps an upload the caller opened on its own.
+    pub(crate) const fn over(upload: U, key: FileKey, mode: WriteMode) -> Self {
+        Self {
+            key,
+            upload,
+            written: 0,
+            mode,
+        }
+    }
+
+    /// Publishes without the check against the bytes written.
+    ///
+    /// # Errors
+    /// What the store's commit returned.
+    pub(crate) async fn commit_unchecked(self) -> Result<FileInfo, StoreError> {
+        self.upload.commit().await
+    }
