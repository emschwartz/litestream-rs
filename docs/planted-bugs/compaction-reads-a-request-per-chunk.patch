+/// A request per chunk.
+struct PerRead<'a, S> {
+    source: &'a S,
+    key: FileKey,
+    offset: u64,
+}
+
+impl<S: ObjectStore> ReadStream for PerRead<'_, S> {
+    fn next(&mut self, len: ReadLen) -> crate::store::BoxFuture<'_, Result<Vec<u8>, StoreError>> {
+        Box::pin(async move {
+            let bytes = self.source.read(&self.key, self.offset, len).await?;
+            self.offset = self
+                .offset
+                .saturating_add(u64::try_from(bytes.len()).unwrap_or(u64::MAX));
+            Ok(bytes)
+        })
+    }
+}
