index 9f9477690..d2187c7a7 100644
--- a/crates/core/src/actor/state.rs
+++ b/crates/core/src/actor/state.rs
@@ -126,6 +126,13 @@ impl Retry {
     /// Lets a passed wait go: the task is ready, and its deadline is no
     /// longer one the actor holds. The failure count stays for the doubling.
     pub(super) fn expire(&mut self, now: Timestamp) {
+        // A retry that comes long after its wait ended starts a new run of failures.
+        if self
+            .until
+            .is_some_and(|until| now > until.saturating_add(std::time::Duration::from_secs(30)))
+        {
+            self.attempts = None;
+        }
         self.until = self.until.filter(|until| *until > now);
     }
 
